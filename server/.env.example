APP_ENV=production
APP_URL=https://alpes-ex.fr

DB_HOST=db.example.invalid
DB_PORT=3306
DB_NAME=database_name
DB_USERNAME=database_user
DB_PASSWORD=replace_me

SMTP_HOST=smtp.ionos.fr
SMTP_PORT=465
SMTP_ENCRYPTION=smtps
SMTP_USERNAME=notifications@alpes-ex.fr
SMTP_PASSWORD=replace_me

MAIL_FROM_ADDRESS=notifications@alpes-ex.fr
MAIL_FROM_NAME="ALPES'Ex"
MAIL_REPLY_TO_ADDRESS=contact@alpes-ex.fr
MAIL_REPLY_TO_NAME="ALPES'Ex — Contact"

# Clé Ed25519 PKCS#8 de l'autorité CPMP — ASM. Ce fichier reste hors du Web et de GitHub.
ALPESEX_LICENSE_PRIVATE_KEY_PATH=/home/www/private/licenses/issuer-private.pem
